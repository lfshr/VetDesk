@* A second member of staff confirms a controlled drug entry with their own PIN. *@
@inject Backend Backend
@inject UserSession Session

<div class="vd-form-grid">
    <div class="vd-field">
        <label for="@($"{Id}-who")">Witness</label>
        <select id="@($"{Id}-who")" value="@(WitnessId?.ToString() ?? "")" @onchange="Pick">
            <option value="">Choose a witness</option>
            @foreach (var s in _witnesses)
            {
                <option value="@s.Id">@s.ShortName (@s.JobTitle)</option>
            }
        </select>
    </div>
    <div class="vd-field">
        <label for="@($"{Id}-pin")">Witness's PIN</label>
        <input id="@($"{Id}-pin")" type="password" inputmode="numeric" maxlength="4" autocomplete="off" class="vd-mono" value="@Pin" @oninput="e => PinChanged.InvokeAsync(e.Value?.ToString())" />
    </div>
</div>
<div class="vd-hint">The witness types their own PIN to confirm they saw the amount. It isn't stored.</div>

@code {
    [Parameter] public string Id { get; set; } = "witness";
    [Parameter] public int? WitnessId { get; set; }
    [Parameter] public EventCallback<int?> WitnessIdChanged { get; set; }
    [Parameter] public string? Pin { get; set; }
    [Parameter] public EventCallback<string?> PinChanged { get; set; }

    private IReadOnlyList<StaffDto> _witnesses = [];

    protected override async Task OnInitializedAsync()
    {
        var staff = await Backend.Send(new GetStaffQuery { WitnessesOnly = true });
        if (staff.IsSuccess)
            _witnesses = staff.Value.Where(s => s.Id != Session.Staff?.StaffId).ToList();
    }

    private Task Pick(ChangeEventArgs e) =>
        WitnessIdChanged.InvokeAsync(int.TryParse(e.Value?.ToString(), out var id) ? id : null);
}
