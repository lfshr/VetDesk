<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!-- Local development: running this project starts SQL Server in a container (Docker or Podman) and runs
       VetDesk.Web and VetDesk.Desktop against it, with the Aspire dashboard for logs and traces. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <!-- Holds the generated SQL Server sa password, so it keeps matching the persistent data volume. -->
    <UserSecretsId>3f6d5b7e-2c41-4a8e-9b0d-7a1e5c9f4d21</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetDesk.Web\VetDesk.Web.csproj" />
    <ProjectReference Include="..\VetDesk.Desktop\VetDesk.Desktop.csproj" />
  </ItemGroup>

</Project>
