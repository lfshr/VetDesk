@* Add or edit a member of staff. The administrator sets the first PIN and passes it on; administrators also get a password. *@
@inject Backend Backend
@inject ToastService Toasts

<Modal Title="@(Staff is null ? "Add user" : $"Edit {Staff.FullName}")" Subtitle="@(Staff is null ? "Give them their PIN; they can change it under My PIN and password." : null)" OnClose="OnClose">
    <ChildContent>
        <div class="vd-form-grid">
            <div class="vd-field" style="margin-top:0"><label for="sd-first">First name</label><input id="sd-first" @bind="_first" @bind:event="oninput" maxlength="100" /></div>
            <div class="vd-field" style="margin-top:0"><label for="sd-last">Surname (optional)</label><input id="sd-last" @bind="_last" @bind:event="oninput" maxlength="100" /></div>
            <div class="vd-field vd-field-wide"><label for="sd-email">Work email (optional)</label><input id="sd-email" type="email" @bind="_email" @bind:event="oninput" maxlength="200" /></div>
            <div class="vd-field">
                <label for="sd-role">Role</label>
                <select id="sd-role" @bind="_role" @bind:after="StateHasChanged">
                    @foreach (var r in Enum.GetValues<StaffRole>())
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <div class="vd-field"><label for="sd-reg">Registration number</label><input id="sd-reg" class="vd-mono" @bind="_reg" placeholder="Vets and nurses only" maxlength="40" /></div>
            <div class="vd-field">
                <label for="sd-pin">@(Staff is null ? "PIN" : "Reset PIN (leave blank to keep)")</label>
                <input id="sd-pin" type="text" inputmode="numeric" autocomplete="off" class="vd-mono" @bind="_pin" @bind:event="oninput" maxlength="4" />
                <div class="vd-hint">4 digits@(Staff is null ? "" : ". Also clears a lock-out after wrong PINs")</div>
            </div>
            @if (IsAdmin)
            {
                <div class="vd-field">
                    <label for="sd-pw">@(NeedsPassword ? "Administrator password" : "Reset password (leave blank to keep)")</label>
                    <input id="sd-pw" type="text" autocomplete="off" class="vd-mono" @bind="_password" @bind:event="oninput" maxlength="200" />
                    <div class="vd-hint">At least 10 characters. Opens users and settings.</div>
                </div>
            }
        </div>
        <label class="vd-check"><input type="checkbox" @bind="_admin" @bind:after="StateHasChanged" /> Administrator (can manage users and settings)</label>
        @if (Staff is not null)
        {
            <label class="vd-check" style="margin-left:24px"><input type="checkbox" @bind="_active" /> Active</label>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="vd-btn vd-btn-secondary" @onclick="OnClose">Cancel</button>
        <button type="button" class="vd-btn vd-btn-primary" disabled="@(!CanSave || _saving)" @onclick="Save">@(Staff is null ? "Add user" : "Save")</button>
    </Footer>
</Modal>

@code {
    [Parameter] public StaffDto? Staff { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _first = "", _last = "", _email = "", _pin = "", _password = "";
    private string? _reg;
    private StaffRole _role = StaffRole.Reception;
    private bool _admin, _active = true, _saving;

    private bool IsAdmin => _admin || _role == StaffRole.Admin;
    private bool NeedsPassword => IsAdmin && Staff?.HasPassword != true;

    private bool CanSave => !string.IsNullOrWhiteSpace(_first)
                            && (_pin.Length == 4 || (Staff is not null && _pin.Length == 0))
                            && (!NeedsPassword || _password.Length >= 10);

    protected override void OnInitialized()
    {
        if (Staff is not { } s)
            return;
        (_first, _last, _email, _reg, _role, _admin, _active) = (s.FirstName, s.LastName, s.Email ?? "", s.RegistrationNumber, s.Role, s.IsAdministrator, s.IsActive);
    }

    private async Task Save()
    {
        _saving = true;
        var result = await Backend.Send(new SaveStaffMemberCommand
        {
            Id = Staff?.Id, FirstName = _first, LastName = _last, Email = _email, Role = _role, IsAdministrator = _admin,
            RegistrationNumber = _reg, IsActive = _active,
            Pin = _pin.Length == 0 ? null : _pin,
            Password = IsAdmin && _password.Length > 0 ? _password : null,
        });
        _saving = false;
        if (Toasts.Check(result, Staff is null ? $"{_first.Trim()} added" : "User saved"))
            await OnSaved.InvokeAsync();
    }
}
