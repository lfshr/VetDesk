@* Edits one patient alert inline under the chips: pick a preset or write your own, then choose how serious it is. *@
@inject DialogService Dialogs

<div class="vd-alert-editor" role="group" aria-label="@Title">
    <div class="vd-alert-editor-head">
        <span>@Title</span>
        @if (Alert.Id is { } id)
        {
            <button type="button" class="vd-icon-btn-danger" aria-label="Delete alert" title="Delete alert" @onclick="() => Delete(id)"><Icon Name="trash" Size="16" /></button>
        }
    </div>
    @if (_preset is null)
    {
        <div class="vd-field">
            <label for="alert-preset">Alert</label>
            <select id="alert-preset" @onchange="PickPreset">
                <option value="" selected disabled>Select an alert…</option>
                @foreach (var group in PatientAlert.Presets.GroupBy(p => p.Severity))
                {
                    <optgroup label="@GroupLabel(group.Key)">
                        @foreach (var p in group)
                        {
                            <option value="@p.Key">@p.Text</option>
                        }
                    </optgroup>
                }
                <option value="custom">Other (type your own)…</option>
            </select>
        </div>
    }
    else
    {
        <div class="vd-field">
            <div class="vd-row-between">
                <label for="alert-text">Alert</label>
                @if (Alert.Id is null)
                {
                    <button type="button" class="vd-btn-link vd-small" @onclick="Repick">Choose from list instead</button>
                }
            </div>
            <input id="alert-text" @bind="_text" @bind:event="oninput" maxlength="200" placeholder="e.g. Bites when restrained" />
        </div>
        <div class="vd-field" style="flex:0 0 auto">
            <span class="vd-label">Severity</span>
            <div class="vd-segmented" role="group" aria-label="Severity">
                @foreach (var s in Enum.GetValues<AlertSeverity>())
                {
                    <button type="button" aria-pressed="@Aria.Bool(_severity == s)" @onclick="() => _severity = s"><span class="vd-sev-dot vd-sev-dot-@s.ToString().ToLowerInvariant()"></span>@s</button>
                }
            </div>
        </div>
    }
    <div class="vd-alert-editor-foot">
        <button type="button" class="vd-btn vd-btn-secondary" @onclick="OnClose">Cancel</button>
        <button type="button" class="vd-btn vd-btn-primary" disabled="@(_preset is null || string.IsNullOrWhiteSpace(_text))" @onclick="Save">@(Alert.Id is null ? "Add alert" : "Save")</button>
    </div>
</div>

@code {
    public record Draft(int? Id, string? PresetKey, string Text, AlertSeverity Severity);

    [Parameter, EditorRequired] public Draft Alert { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<Draft> OnSave { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    private string? _preset;
    private string _text = "";
    private AlertSeverity _severity;
    private Draft? _loaded;

    private string Title => Alert.Id is null ? "New alert" : "Edit alert";

    private static string GroupLabel(AlertSeverity severity) => severity switch
    {
        AlertSeverity.Alert => "Alerts",
        AlertSeverity.Warning => "Warnings",
        _ => "Notes"
    };

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loaded, Alert))
            return;
        _loaded = Alert;
        _preset = Alert.PresetKey;
        _text = Alert.Text;
        _severity = Alert.Severity;
    }

    private void PickPreset(ChangeEventArgs e)
    {
        var key = e.Value?.ToString();
        if (string.IsNullOrEmpty(key))
            return;
        _preset = key;
        if (PatientAlert.Presets.FirstOrDefault(p => p.Key == key) is { Text: not null } preset)
        {
            _text = preset.Text;
            _severity = preset.Severity;
        }
        else
        {
            _text = "";
        }
    }

    private void Repick()
    {
        _preset = null;
        _text = "";
        _severity = AlertSeverity.Warning;
    }

    private Task Save() => OnSave.InvokeAsync(new Draft(Alert.Id, _preset, _text, _severity));

    private async Task Delete(int id)
    {
        if (await Dialogs.ConfirmAsync($"Are you sure you want to delete “{Alert.Text}”?", null, "Delete", isDanger: true))
            await OnDelete.InvokeAsync(id);
    }
}
