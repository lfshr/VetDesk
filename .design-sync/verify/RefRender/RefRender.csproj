<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the real Blazor shared components (with bUnit, so cases can type and click) to HTML, so the React
       mirrors can be compared against them. Run by .design-sync/verify/compare.mjs; not part of VetDesk.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../src/VetDesk.UI/VetDesk.UI.csproj" />
  </ItemGroup>

</Project>
