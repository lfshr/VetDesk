@inject Backend Backend
@inject ToastService Toasts
@inject UserSession Session

<section class="vd-card" aria-labelledby="pin-title" style="max-width:520px">
    <div class="vd-card-head"><h2 id="pin-title" class="vd-section-title">My PIN</h2></div>
    <form class="vd-card-body" @onsubmit="SavePin" @onsubmit:preventDefault>
        <div class="vd-form-grid" style="grid-template-columns:repeat(3,minmax(0,1fr))">
            <div class="vd-field" style="margin-top:0"><label for="pin-current">Current PIN</label><input id="pin-current" type="password" inputmode="numeric" maxlength="4" autocomplete="off" class="vd-mono" @bind="_currentPin" @bind:event="oninput" /></div>
            <div class="vd-field" style="margin-top:0"><label for="pin-new">New PIN</label><input id="pin-new" type="password" inputmode="numeric" maxlength="4" autocomplete="off" class="vd-mono" @bind="_newPin" @bind:event="oninput" /></div>
            <div class="vd-field" style="margin-top:0"><label for="pin-confirm">New PIN again</label><input id="pin-confirm" type="password" inputmode="numeric" maxlength="4" autocomplete="off" class="vd-mono" @bind="_confirmPin" @bind:event="oninput" /></div>
        </div>
        <div class="vd-hint">4 digits. Avoid your birthday or 1234.</div>
        @if (_confirmPin.Length > 0 && _confirmPin != _newPin)
        {
            <div class="vd-error-text">The new PINs don't match.</div>
        }
        <button type="submit" class="vd-btn vd-btn-primary" style="margin-top:16px" disabled="@(_newPin.Length != 4 || _newPin != _confirmPin || _currentPin.Length == 0)">Change PIN</button>
    </form>
</section>

@if (Session.Staff is { } staff && (staff.IsAdministrator || staff.Role == StaffRole.Admin))
{
    <section class="vd-card" aria-labelledby="pw-title" style="max-width:520px;margin-top:16px">
        <div class="vd-card-head"><h2 id="pw-title" class="vd-section-title">My administrator password</h2></div>
        <form class="vd-card-body" @onsubmit="SavePassword" @onsubmit:preventDefault>
            <div class="vd-field" style="margin-top:0"><label for="pw-current">Current password</label><input id="pw-current" type="password" autocomplete="current-password" @bind="_current" @bind:event="oninput" /></div>
            <div class="vd-field"><label for="pw-new">New password</label><input id="pw-new" type="password" autocomplete="new-password" @bind="_new" @bind:event="oninput" /></div>
            <div class="vd-field"><label for="pw-confirm">New password again</label><input id="pw-confirm" type="password" autocomplete="new-password" @bind="_confirm" @bind:event="oninput" /></div>
            <div class="vd-hint">At least 10 characters. A short sentence is easier to remember than a jumble.</div>
            @if (_confirm.Length > 0 && _confirm != _new)
            {
                <div class="vd-error-text">The new passwords don't match.</div>
            }
            <button type="submit" class="vd-btn vd-btn-primary" style="margin-top:16px" disabled="@(_new.Length < 10 || _new != _confirm || _current.Length == 0)">Change password</button>
        </form>
    </section>
}

@code {
    private string _currentPin = "", _newPin = "", _confirmPin = "";
    private string _current = "", _new = "", _confirm = "";

    private async Task SavePin()
    {
        var result = await Backend.Send(new ChangePinCommand { CurrentPin = _currentPin, NewPin = _newPin });
        if (Toasts.Check(result, "PIN changed"))
            _currentPin = _newPin = _confirmPin = "";
    }

    private async Task SavePassword()
    {
        var result = await Backend.Send(new ChangePasswordCommand { CurrentPassword = _current, NewPassword = _new });
        if (Toasts.Check(result, "Password changed"))
            _current = _new = _confirm = "";
    }
}
