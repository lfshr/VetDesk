<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Runs the VetDesk screens (VetDesk.UI) as Blazor Server: the app the practice server runs, and the only part of
       VetDesk that connects to the database. Desks open it in the VetDesk.Desktop window or a browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetDesk.UI\VetDesk.UI.csproj" />
    <ProjectReference Include="..\VetDesk.Infrastructure\VetDesk.Infrastructure.csproj" />
    <ProjectReference Include="..\VetDesk.ServiceDefaults\VetDesk.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
