@* Under a box someone else is in: "Heather is editing…". The box is read-only here meanwhile. *@
@if (By is not null)
{
    <div class="vd-typing" role="status"><span class="vd-presence-dot" aria-hidden="true"></span>@By is editing…</div>
}

@code {
    [Parameter] public string? By { get; set; }
}
