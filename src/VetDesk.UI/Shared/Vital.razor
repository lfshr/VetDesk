@* One vital sign box on the consultation note: label, value, unit. A live box, so other desks see it typed. *@
@inherits VetDesk.UI.Shared.Live.LiveField
<div class="vd-field">
    <label for="@Id">@Label</label>
    <div style="position:relative">
        <input id="@Id" class="vd-mono" style="width:100%;padding-right:@(string.IsNullOrEmpty(Unit) ? "12px" : "40px")" inputmode="@(Text ? "text" : "decimal")"
               value="@Value" @oninput="Type" @onfocus="Enter" @onblur="Leave" disabled="@ReadOnly" maxlength="40" />
        @if (!string.IsNullOrEmpty(Unit))
        {
            <span class="vd-small vd-muted" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);pointer-events:none">@Unit</span>
        }
    </div>
    <TypingNote By="@TypingBy" />
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Unit { get; set; } = "";
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter] public bool Text { get; set; }
}
