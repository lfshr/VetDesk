@inject Backend Backend
@inject ToastService Toasts

<section class="vd-card" aria-labelledby="pw-title" style="max-width:520px">
    <div class="vd-card-head"><h2 id="pw-title" class="vd-section-title">My password</h2></div>
    <form class="vd-card-body" @onsubmit="Save" @onsubmit:preventDefault>
        <div class="vd-field" style="margin-top:0"><label for="pw-current">Current password</label><input id="pw-current" type="password" autocomplete="current-password" @bind="_current" @bind:event="oninput" /></div>
        <div class="vd-field"><label for="pw-new">New password</label><input id="pw-new" type="password" autocomplete="new-password" @bind="_new" @bind:event="oninput" /></div>
        <div class="vd-field"><label for="pw-confirm">New password again</label><input id="pw-confirm" type="password" autocomplete="new-password" @bind="_confirm" @bind:event="oninput" /></div>
        <div class="vd-hint">At least 10 characters. A short sentence is easier to remember than a jumble.</div>
        @if (_confirm.Length > 0 && _confirm != _new)
        {
            <div class="vd-error-text">The new passwords don't match.</div>
        }
        <button type="submit" class="vd-btn vd-btn-primary" style="margin-top:16px" disabled="@(_new.Length < 10 || _new != _confirm || _current.Length == 0)">Change password</button>
    </form>
</section>

@code {
    private string _current = "", _new = "", _confirm = "";

    private async Task Save()
    {
        var result = await Backend.Send(new ChangePasswordCommand { CurrentPassword = _current, NewPassword = _new });
        if (Toasts.Check(result, "Password changed"))
            _current = _new = _confirm = "";
    }
}
