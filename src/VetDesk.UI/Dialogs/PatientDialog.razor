@* Add a pet to an owner, or edit an existing patient's details. *@
@inject Backend Backend
@inject ToastService Toasts

<Modal Title="@(Patient is null ? "Add a pet" : $"Edit {Patient.Name}")" OnClose="OnClose" Size="wide">
    <ChildContent>
        <div class="vd-form-grid-3">
            <div class="vd-field"><label for="pd-name">Name</label><input id="pd-name" @bind="_name" maxlength="100" /></div>
            <div class="vd-field">
                <label for="pd-species">Species</label>
                <select id="pd-species" @bind="_species">
                    @foreach (var s in VetDesk.Domain.Entities.Patients.Patient.SpeciesOptions.Union([_species]))
                    {
                        <option>@s</option>
                    }
                </select>
            </div>
            <div class="vd-field"><label for="pd-breed">Breed</label><input id="pd-breed" @bind="_breed" maxlength="100" /></div>
            <div class="vd-field">
                <label for="pd-sex">Sex</label>
                <select id="pd-sex" @bind="_sex">
                    @foreach (var s in Enum.GetValues<Sex>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="vd-field"><label for="pd-dob">Date of birth</label><input id="pd-dob" type="date" @bind="_dob" /></div>
            <div class="vd-field"><label for="pd-chip">Microchip</label><input id="pd-chip" class="vd-mono" @bind="_chip" maxlength="40" /></div>
        </div>
        <label class="vd-check"><input type="checkbox" @bind="_neutered" /> Neutered</label>
        @if (Patient is not null)
        {
            <label class="vd-check" style="margin-left:24px"><input type="checkbox" @bind="_deceased" /> Deceased</label>
            <div class="vd-hint">Marking a pet deceased stops reminders and hides them from booking.</div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="vd-btn vd-btn-secondary" @onclick="OnClose">Cancel</button>
        <button type="button" class="vd-btn vd-btn-primary" disabled="@(string.IsNullOrWhiteSpace(_name) || _saving)" @onclick="Save">@(Patient is null ? "Add pet" : "Save")</button>
    </Footer>
</Modal>

@code {
    [Parameter] public PatientDetail? Patient { get; set; }
    [Parameter] public int ClientId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _name = "", _species = "Dog";
    private string? _breed, _chip;
    private Sex _sex;
    private DateOnly? _dob;
    private bool _neutered, _deceased, _saving;

    protected override void OnInitialized()
    {
        if (Patient is not { } p)
            return;
        _name = p.Name;
        _species = p.Species;
        _breed = p.Breed;
        _sex = p.Sex;
        _dob = p.DateOfBirth;
        _chip = p.Microchip;
        _neutered = p.IsNeutered;
        _deceased = p.IsDeceased;
    }

    private async Task Save()
    {
        _saving = true;
        var result = await Backend.Send(new SavePatientCommand
        {
            Id = Patient?.Id, ClientId = Patient?.Owner.Id ?? ClientId, Name = _name, Species = _species, Breed = _breed, Sex = _sex,
            IsNeutered = _neutered, DateOfBirth = _dob, Microchip = _chip, IsDeceased = _deceased, Version = Patient?.Version
        });
        _saving = false;
        if (Toasts.Check(result, Patient is null ? $"{_name.Trim()} added" : "Details saved"))
            await OnSaved.InvokeAsync();
    }
}
