<!DOCTYPE html>
<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>VetDesk</title>
    <link rel="stylesheet" href="_content/VetDesk.UI/vetdesk.css" />
    <HeadOutlet @rendermode="RenderModeNoPrerender" />
</head>

<body>
    <Routes @rendermode="RenderModeNoPrerender" />
    <div id="components-reconnect-modal">
        <div class="vd-reconnect-dialog">
            <div class="vd-reconnect-spinner"></div>
            <p class="vd-reconnect-text">Reconnecting&hellip;</p>
            <p class="vd-reconnect-text vd-reconnect-text-failed">Couldn't reconnect.</p>
            <button type="button" class="vd-btn vd-btn-secondary vd-reconnect-reload" onclick="location.reload()">Reload</button>
        </div>
    </div>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/VetDesk.UI/vetdesk.js"></script>
</body>

</html>

@code {
    // Prerendering would load every screen's data twice, and before anyone has signed in.
    private static readonly IComponentRenderMode RenderModeNoPrerender = new InteractiveServerRenderMode(prerender: false);
}
