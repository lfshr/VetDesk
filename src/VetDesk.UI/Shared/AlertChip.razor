@using VetDesk.Domain.Entities.Patients

<span class="vd-chip @Css @(Large ? "vd-chip-lg" : "")" title="@Title">
    <Icon Name="@IconName" Size="14" /> @Text
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public AlertSeverity Severity { get; set; }
    [Parameter] public bool IsAllergy { get; set; }
    /// <summary>The bigger, outlined chip the patient record header uses.</summary>
    [Parameter] public bool Large { get; set; }

    private string Css => IsAllergy || Severity == AlertSeverity.Alert ? "vd-chip-danger"
        : Severity == AlertSeverity.Warning ? "vd-chip-warning" : "vd-chip-success";

    // As in the design: a triangle for alerts, a circled "!" for warnings, a circled "i" for notes.
    private string IconName => IsAllergy || Severity == AlertSeverity.Alert ? "alert"
        : Severity == AlertSeverity.Warning ? "warning" : "info";

    private string Title => IsAllergy ? "Drug allergy" : Severity.ToString();
}
