@* Line icons from the VetDesk design (24px grid, stroked with the current text colour). *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "today":
            <rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4" /><circle cx="12" cy="14.5" r="1.6" fill="currentColor" />
            break;
        case "schedule":
            <rect x="3.5" y="5" width="17" height="15" rx="2" /><path d="M3.5 9.5h17M8 3v4M16 3v4M9.5 9.5V20M14.5 9.5V20M3.5 14.75h17" />
            break;
        case "paw":
            <circle cx="7" cy="9" r="1.9" /><circle cx="11" cy="5.8" r="1.9" /><circle cx="15.5" cy="6.6" r="1.9" /><circle cx="18.3" cy="10.6" r="1.9" />
            <path d="M8.2 16.6c0-2.6 2-4.9 4.5-4.9s4.3 2.1 4.3 4.5c0 1.9-1.3 3.3-3 3.3-.8 0-1.4-.4-2-.4s-1.1.5-2 .5c-1.1 0-1.8-1.2-1.8-3z" />
            break;
        case "owners":
            <circle cx="9" cy="8.5" r="3.2" /><path d="M3.5 19.5c.6-3.2 2.8-5 5.5-5s4.9 1.8 5.5 5" /><circle cx="16.8" cy="9.5" r="2.5" /><path d="M16.5 14.5c2.2.1 3.7 1.6 4.1 4" />
            break;
        case "stethoscope":
            <path d="M6 3.5v5a4 4 0 0 0 8 0v-5" /><path d="M10 12.5v2.5a4.5 4.5 0 0 0 9 0v-1.5" /><circle cx="19" cy="11.5" r="2" />
            break;
        case "pill":
            <rect x="3" y="8.5" width="18" height="7" rx="3.5" transform="rotate(-40 12 12)" /><path d="M9.7 9.3l5 5" />
            break;
        case "receipt":
            <path d="M6 3.5h12v17l-2-1.4-2 1.4-2-1.4-2 1.4-2-1.4-2 1.4z" /><path d="M9 8h6M9 11.5h6M9 15h3.5" />
            break;
        case "chart":
            <path d="M4 20h16" /><rect x="5.5" y="11" width="3" height="6.5" rx=".6" /><rect x="10.5" y="6.5" width="3" height="11" rx=".6" /><rect x="15.5" y="13.5" width="3" height="4" rx=".6" />
            break;
        case "settings":
            <path d="M4 7h9M17 7h3M4 17h3M11 17h9" /><circle cx="15" cy="7" r="2" /><circle cx="9" cy="17" r="2" />
            break;
        case "search":
            <circle cx="11" cy="11" r="6" /><path d="M20 20l-4.6-4.6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "back":
            <path d="M19 12H5M11 6l-6 6 6 6" />
            break;
        case "chevron-left":
            <path d="M14.5 6l-6 6 6 6" />
            break;
        case "chevron-right":
            <path d="M9.5 6l6 6-6 6" />
            break;
        case "refresh":
            <path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3" /><path d="M19.5 4.5v4h-4" />
            break;
        case "alert":
            <path d="M12 4l9 16H3z" /><path d="M12 10v4.5" /><circle cx="12" cy="17.3" r=".6" fill="currentColor" />
            break;
        case "shield":
            <path d="M12 3.5l7 2.5v5.5c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6z" /><path d="M9 12l2.2 2.2L15.5 10" />
            break;
        case "home":
            <path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" />
            break;
        case "bell":
            <path d="M6 9a6 6 0 0 1 12 0c0 6 2.5 7.5 2.5 7.5h-17S6 15 6 9z" /><path d="M10 20a2 2 0 0 0 4 0" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18" />
            break;
        case "check":
            <path d="M5 12.5l4.5 4.5L19 7.5" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case "print":
            <path d="M7 9V3h10v6" /><rect x="3" y="9" width="18" height="8" rx="2" /><path d="M7 14h10v7H7z" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" />
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
            break;
        case "lock":
            <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
            break;
        case "info":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 11v5" /><circle cx="12" cy="8" r=".6" fill="currentColor" />
            break;
        case "warning":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5v5" /><circle cx="12" cy="16" r=".6" fill="currentColor" />
            break;
        case "minus":
            <path d="M5 12h14" />
            break;
        case "card":
            <rect x="3" y="6" width="18" height="12" rx="2" /><path d="M3 10h18M7 15h3" />
            break;
        case "cash":
            <rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /><path d="M6 9.5v5M18 9.5v5" />
            break;
        case "bank":
            <path d="M3 10l9-6 9 6M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18" />
            break;
        case "syringe":
            <path d="M18 3l3 3M16.5 4.5l3 3M19.5 6L10 15.5 8.5 14 18 4.5M8.5 14l-3 3M10 15.5l-3 3M5.5 17L3 21l4-2.5" />
            break;
        case "truck":
            <path d="M3 6h11v10H3zM14 9h4l3 3v4h-7" /><circle cx="7" cy="17.5" r="1.8" /><circle cx="17" cy="17.5" r="1.8" />
            break;
        case "clipboard":
            <rect x="5" y="4.5" width="14" height="16.5" rx="2" /><path d="M9 4.5h6v3H9zM9 12h6M9 16h4" />
            break;
        case "label":
            <path d="M3 12V4h8l10 10-8 8z" /><circle cx="7.5" cy="8.5" r="1.3" />
            break;
        case "sign-out":
            <path d="M15 4h4v16h-4M10 8l-4 4 4 4M6 12h10" />
            break;
        case "file":
            <path d="M6 3h8l4 4v14H6z" /><path d="M14 3v4h4" />
            break;
        case "weight":
            <path d="M6 8h12l2 12H4z" /><circle cx="12" cy="5.5" r="2.2" />
            break;
        case "edit":
            <path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-4-4L4 16z" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 20;
}
