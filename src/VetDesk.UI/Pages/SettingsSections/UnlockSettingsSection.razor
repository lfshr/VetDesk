@* Shown in place of an admin section until the administrator confirms their password. It stays open until the desk locks. *@
@using VetDesk.Application.Staff.Commands
@inject Backend Backend
@inject UserSession Session

<section class="vd-card" aria-labelledby="unlock-title" style="max-width:520px">
    <div class="vd-card-head"><h2 id="unlock-title" class="vd-section-title"><Icon Name="lock" Size="16" /> Administrator password</h2></div>
    <form class="vd-card-body" @onsubmit="Unlock" @onsubmit:preventDefault>
        <p class="vd-muted" style="margin-top:0">Users and practice settings need your password as well as your PIN. They stay open until this desk locks.</p>
        <div class="vd-field"><label for="unlock-pw">Password</label><input id="unlock-pw" type="password" autocomplete="current-password" @bind="_password" @bind:event="oninput" autofocus /></div>
        <FormError Text="@_error" />
        <button type="submit" class="vd-btn vd-btn-primary" style="margin-top:16px" disabled="@(_password.Length == 0 || _busy)">Open settings</button>
    </form>
</section>

@code {
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task Unlock()
    {
        _busy = true;
        _error = null;
        var result = await Backend.Send(new UnlockSettingsCommand { Password = _password });
        _busy = false;
        _password = "";
        if (result.IsFailure)
        {
            _error = result.ToString();
            return;
        }

        Session.UnlockSettings(result.Value);
    }
}
