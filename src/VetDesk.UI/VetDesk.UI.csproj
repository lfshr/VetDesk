<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The VetDesk screens. Hosted by VetDesk.Web (Blazor Server) on the practice server; desks see them through the
       VetDesk.Desktop window or a browser. Screens call the Application layer in-process, on the server. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VetDesk.Application\VetDesk.Application.csproj" />
  </ItemGroup>

</Project>
