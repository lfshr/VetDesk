<Window x:Class="VetDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="VetDesk"
        Icon="Assets/vetdesk.ico"
        Width="1440" Height="900" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0E2A2A">
    <!-- The sidebar colour behind the page while it loads, so the window doesn't flash white. -->
    <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#0E2A2A" />
</Window>
