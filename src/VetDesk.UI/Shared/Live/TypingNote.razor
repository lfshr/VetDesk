@* Under a box someone else is typing in: "Heather is typing…". The box is read-only here meanwhile. *@
@if (By is not null)
{
    <div class="vd-typing" role="status"><span class="vd-presence-dot" aria-hidden="true"></span>@By is typing…</div>
}

@code {
    [Parameter] public string? By { get; set; }
}
