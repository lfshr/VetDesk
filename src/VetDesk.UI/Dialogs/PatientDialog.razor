@* Add a pet to an owner, or edit an existing patient's details. Editing is live: everyone with this patient's details
   open types into the same form and sees the others' typing as it happens. *@
@inject Backend Backend
@inject ToastService Toasts

<LiveEditForm @ref="_form" Topic="@Topic" Saved="Saved" Version="Patient?.Version" OnOtherDesk="OnOtherDesk" Context="form">
    <Modal Title="@(Patient is null ? (OwnerName is null ? "Add a pet" : $"Add pet for {OwnerName}") : $"Edit {Patient.Name}")"
           Subtitle="@(Patient is null ? "The pet gets its own patient record and PT number." : null)" OnClose="OnClose" Size="@(Patient is null ? "560" : "wide")">
        <ChildContent>
            @if (Topic is not null)
            {
                <PresenceBar Topic="@Topic" Editing="true" />
            }
            <div class="@(Patient is null ? "vd-form-grid" : "vd-form-grid-3")">
                <div class="vd-field"><label for="pd-name">Pet name</label><LiveInput Field="Name" id="pd-name" maxlength="100" placeholder="e.g. Pip" /></div>
                <div class="vd-field">
                    <label for="pd-species">Species</label>
                    <LiveSelect Field="Species" id="pd-species">
                        @foreach (var s in VetDesk.Domain.Entities.Patients.Patient.SpeciesOptions.Union([form["Species"] ?? "Dog"]))
                        {
                            <option>@s</option>
                        }
                    </LiveSelect>
                </div>
                <div class="vd-field"><label for="pd-breed">Breed</label><LiveInput Field="Breed" id="pd-breed" maxlength="100" placeholder="Optional" /></div>
                <div class="vd-field">
                    <label for="pd-sex">Sex</label>
                    <LiveSelect Field="Sex" id="pd-sex">
                        @foreach (var s in Enum.GetValues<Sex>())
                        {
                            <option value="@s">@s</option>
                        }
                    </LiveSelect>
                </div>
                <div class="vd-field"><label for="pd-dob">Date of birth</label><LiveInput Field="DateOfBirth" id="pd-dob" type="date" /></div>
                <div class="vd-field"><label for="pd-chip">Microchip</label><LiveInput Field="Microchip" id="pd-chip" class="vd-mono" maxlength="40" placeholder="15 digits, optional" /></div>
            </div>
            <label class="vd-check"><LiveCheckbox Field="IsNeutered" /> Neutered</label>
            @if (Patient is not null)
            {
                <label class="vd-check" style="margin-left:24px"><LiveCheckbox Field="IsDeceased" /> Deceased</label>
                <div class="vd-hint">Marking a pet deceased stops reminders and hides them from booking.</div>
            }
        </ChildContent>
        <Footer>
            <button type="button" class="vd-btn vd-btn-secondary" @onclick="OnClose">Cancel</button>
            <button type="button" class="vd-btn vd-btn-primary" disabled="@(string.IsNullOrWhiteSpace(form["Name"]) || _saving)" @onclick="Save">@(Patient is null ? "Add pet" : "Save")</button>
        </Footer>
    </Modal>
</LiveEditForm>

@code {
    [Parameter] public PatientDetail? Patient { get; set; }
    [Parameter] public int ClientId { get; set; }
    /// <summary>Names the owner in the title when adding a pet, as the design does.</summary>
    [Parameter] public string? OwnerName { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private LiveEditForm _form = default!;
    private bool _saving;

    // A new pet's form is this desk's own; an existing patient's is shared live with every desk editing it.
    private string? Topic => Patient is null ? null : RecordChange.Topic(nameof(VetDesk.Domain.Entities.Patients.Patient), Patient.Id) + "/details";

    private Dictionary<string, string?> Saved => Patient is not { } p
        ? new() { ["Species"] = "Dog", ["Sex"] = default(Sex).ToString(), ["IsNeutered"] = "false", ["IsDeceased"] = "false" }
        : new()
        {
            ["Name"] = p.Name, ["Species"] = p.Species, ["Breed"] = p.Breed, ["Sex"] = p.Sex.ToString(),
            ["DateOfBirth"] = p.DateOfBirth?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), ["Microchip"] = p.Microchip,
            ["IsNeutered"] = p.IsNeutered ? "true" : "false", ["IsDeceased"] = p.IsDeceased ? "true" : "false",
        };

    private async Task OnOtherDesk(LiveDraftEvent e)
    {
        // Saved at another desk with nothing else typed since: the details here are now the record's, so close.
        if (e.Kind == LiveDraftEventKind.Saved && !_form.IsDirty)
        {
            Toasts.Success($"{e.Name} saved {Patient?.Name}'s details");
            await OnSaved.InvokeAsync();
        }
    }

    private async Task Save()
    {
        _saving = true;
        string? name = null;
        var result = await _form.SaveAsync((v, version) =>
        {
            name = v.GetValueOrDefault("Name");
            return Backend.Send(new SavePatientCommand
            {
                Id = Patient?.Id, ClientId = Patient?.Owner.Id ?? ClientId, Name = name ?? "",
                Species = v.GetValueOrDefault("Species") ?? "Dog", Breed = v.GetValueOrDefault("Breed"),
                Sex = Enum.TryParse<Sex>(v.GetValueOrDefault("Sex"), out var sex) ? sex : default,
                DateOfBirth = DateOnly.TryParse(v.GetValueOrDefault("DateOfBirth"), CultureInfo.InvariantCulture, out var dob) ? dob : null,
                Microchip = v.GetValueOrDefault("Microchip"), IsNeutered = v.GetValueOrDefault("IsNeutered") == "true",
                IsDeceased = v.GetValueOrDefault("IsDeceased") == "true", Version = version
            });
        });
        _saving = false;
        // Null: another desk saved these details while this one waited, so they're saved.
        if (result is null || Toasts.Check(result, Patient is null ? $"{name?.Trim()} added" : "Details saved"))
            await OnSaved.InvokeAsync();
    }
}
